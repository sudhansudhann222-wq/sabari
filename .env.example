# Supabase Configuration
# You can get these from your Supabase Dashboard: Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# The order endpoint calculates the total from the server-side product catalog.
VITE_RAZORPAY_ORDER_ENDPOINT=https://YOUR_PROJECT_REF.supabase.co/functions/v1/checkout-order
VITE_RAZORPAY_VERIFY_ENDPOINT=https://YOUR_PROJECT_REF.supabase.co/functions/v1/razorpay-verify

# Optional: set true only for local phone OTP UI demos; defaults to real Twilio SMS.
VITE_DEMO_PHONE_OTP=false

